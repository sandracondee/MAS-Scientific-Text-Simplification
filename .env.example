# ============================================================================
# API Keys for LLM Providers
# ============================================================================

# --- GEMINI via OpenRouter ---
OPENROUTER_API_KEY=your-openrouter-api-key-here

# --- GROQ (gpt-oss, open-weight models) ---
GROQ_API_KEY=your-groq-api-key-here

# --- MISTRAL ---
MISTRAL_API_KEY=your-mistral-api-key-here

# --- DEEPSEEK (via OpenRouter, usa OPENROUTER_API_KEY) ---

# ============================================================================
# MODELS FOR AGENTS: Assign a provider to each agent
# ============================================================================

GUARDRAIL_PROVIDER=gemini
GUARDRAIL_MODEL=gemini-2.5-flash-lite

DRAFTER_PROVIDER_A=gemini
DRAFTER_PROVIDER_B=groq
DRAFTER_PROVIDER_C=mistral
DRAFTER_PROVIDER_D=deepseek

DRAFTER_MODEL_A=gemini-2.5-flash-lite
DRAFTER_MODEL_B=openai/gpt-oss-120b
DRAFTER_MODEL_C=mistral-small-2603
DRAFTER_MODEL_D=~deepseek/deepseek-v4-flash-latest

JUDGE_PROVIDER=groq
JUDGE_MODEL=openai/gpt-oss-120b

EDITOR_PROVIDER=mistral
EDITOR_MODEL=mistral-small-2603

FACT_CHECKER_PROVIDER=groq
FACT_CHECKER_MODEL=openai/gpt-oss-120b

READABILITY_EVALUATOR_PROVIDER=gemini
READABILITY_EVALUATOR_MODEL=gemini-2.5-flash-lite

TERM_EXPLAINER_PROVIDER=gemini
TERM_EXPLAINER_MODEL=gemini-2.5-flash-lite

MCP_METRICS_SERVER_URL=http://127.0.0.1:8020/mcp/
MCP_SEARCH_SERVER_URL=http://127.0.0.1:8021/mcp/